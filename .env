# === MySQL ===
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=bakery

# === Сервер ===
# Внутри Docker хост БД называется "db".
# Для команд Prisma с ХОСТА используйте localhost:3306 (передавайте DATABASE_URL инлайн).
DATABASE_URL=mysql://root:rootpass@db:3306/bakery
JWT_SECRET=dev-secret-change-me
PORT=3000

# Администратор по умолчанию (создаётся сид-скриптом)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin
